[Unit]
Description=AI Hub: live dashboard of coding agents and Backlog.md boards
After=network.target

[Service]
ExecStart=%h/.local/bin/ai-hub serve
# backlog (mise) для дошок; ai-hub — scripts/build-ai-hub.sh
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
