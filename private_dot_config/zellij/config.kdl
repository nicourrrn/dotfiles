keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" "Ctrl п" { SwitchToMode "Normal"; }
    }
    pane {
        bind "Left" { MoveFocus "Left"; }
        bind "Down" { MoveFocus "Down"; }
        bind "Up" { MoveFocus "Up"; }
        bind "Right" { MoveFocus "Right"; }
        bind "h" "р" { MoveFocus "Left"; }
        bind "j" "о" { MoveFocus "Down"; }
        bind "k" "л" { MoveFocus "Up"; }
        bind "l" "д" { MoveFocus "Right"; }
        bind "c" "с" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "d" "в" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "e" "у" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "f" "а" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "i" "ш" { TogglePanePinned; SwitchToMode "Normal"; }
        bind "n" "т" { NewPane; SwitchToMode "Normal"; }
        bind "p" "з" { SwitchFocus; }
        bind "Ctrl p" "Ctrl з" { SwitchToMode "Normal"; }
        bind "r" "к" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" "і" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "w" "ц" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "z" "я" { TogglePaneFrames; SwitchToMode "Normal"; }
    }
    tab {
        bind "Left" { GoToPreviousTab; }
        bind "Down" { GoToNextTab; }
        bind "Up" { GoToPreviousTab; }
        bind "Right" { GoToNextTab; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "[" "х" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "]" "ї" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "b" "и" { BreakPane; SwitchToMode "Normal"; }
        bind "h" "р" { GoToPreviousTab; }
        bind "j" "о" { GoToNextTab; }
        bind "k" "л" { GoToPreviousTab; }
        bind "l" "д" { GoToNextTab; }
        bind "n" "т" { NewTab; SwitchToMode "Normal"; }
        bind "r" "к" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" "і" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "Ctrl t" "Ctrl е" { SwitchToMode "Normal"; }
        bind "x" "ч" { CloseTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }
    resize {
        bind "Left" { Resize "Increase Left"; }
        bind "Down" { Resize "Increase Down"; }
        bind "Up" { Resize "Increase Up"; }
        bind "Right" { Resize "Increase Right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Increase"; }
        bind "H" "Р" { Resize "Decrease Left"; }
        bind "J" "О" { Resize "Decrease Down"; }
        bind "K" "Л" { Resize "Decrease Up"; }
        bind "L" "Д" { Resize "Decrease Right"; }
        bind "h" "р" { Resize "Increase Left"; }
        bind "j" "о" { Resize "Increase Down"; }
        bind "k" "л" { Resize "Increase Up"; }
        bind "l" "д" { Resize "Increase Right"; }
        bind "Ctrl n" "Ctrl т" { SwitchToMode "Normal"; }
    }
    move {
        bind "Left" { MovePane "Left"; }
        bind "Down" { MovePane "Down"; }
        bind "Up" { MovePane "Up"; }
        bind "Right" { MovePane "Right"; }
        bind "h" "р" { MovePane "Left"; }
        bind "Ctrl h" "Ctrl р" { SwitchToMode "Normal"; }
        bind "j" "о" { MovePane "Down"; }
        bind "k" "л" { MovePane "Up"; }
        bind "l" "д" { MovePane "Right"; }
        bind "n" "т" { MovePane; }
        bind "p" "з" { MovePaneBackwards; }
        bind "Tab" { MovePane; }
    }
    scroll {
        bind "e" "у" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" "і" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }
    search {
        bind "c" "с" { SearchToggleOption "CaseSensitivity"; }
        bind "n" "т" { Search "down"; }
        bind "o" "щ" { SearchToggleOption "WholeWord"; }
        bind "p" "з" { Search "up"; }
        bind "w" "ц" { SearchToggleOption "Wrap"; }
    }
    session {
        bind "a" "ф" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "c" "с" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "Ctrl o" "Ctrl щ" { SwitchToMode "Normal"; }
        bind "p" "з" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "s" "і" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "w" "ц" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }
    shared_except "locked" {
        bind "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt Down" { MoveFocus "Down"; }
        bind "Alt Up" { MoveFocus "Up"; }
        bind "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt [" "Alt х" { PreviousSwapLayout; }
        bind "Alt ]" "Alt ї" { NextSwapLayout; }
        bind "Alt f" "Alt а" { ToggleFloatingPanes; }
        bind "Ctrl g" "Ctrl п" { SwitchToMode "Locked"; }
        bind "Alt h" "Alt р" { MoveFocusOrTab "Left"; }
        bind "Alt i" "Alt ш" { MoveTab "Left"; }
        bind "Alt j" "Alt о" { MoveFocus "Down"; }
        bind "Alt k" "Alt л" { MoveFocus "Up"; }
        bind "Alt l" "Alt д" { MoveFocusOrTab "Right"; }
        bind "Alt n" "Alt т" { NewPane; }
        bind "Alt o" "Alt щ" { MoveTab "Right"; }
        bind "Alt p" "Alt з" { TogglePaneInGroup; }
        bind "Alt Shift p" "Alt Shift з" "Alt Shift З" { ToggleGroupMarking; }
        bind "Ctrl q" "Ctrl й" { Quit; }
    }
    shared_except "locked" "move" {
        bind "Ctrl h" "Ctrl р" { SwitchToMode "Move"; }
    }
    shared_except "locked" "session" {
        bind "Ctrl o" "Ctrl щ" { SwitchToMode "Session"; }
    }
    shared_except "locked" "scroll" "search" "tmux" {
        bind "Ctrl b" "Ctrl и" { SwitchToMode "Tmux"; }
    }
    shared_except "locked" "scroll" "search" {
        bind "Ctrl s" "Ctrl і" { SwitchToMode "Scroll"; }
    }
    shared_except "locked" "tab" {
        bind "Ctrl t" "Ctrl е" { SwitchToMode "Tab"; }
    }
    shared_except "locked" "pane" {
        bind "Ctrl p" "Ctrl з" { SwitchToMode "Pane"; }
    }
    shared_except "locked" "resize" {
        bind "Ctrl n" "Ctrl т" { SwitchToMode "Resize"; }
    }
    shared_except "normal" "locked" "entersearch" {
        bind "Enter" { SwitchToMode "Normal"; }
    }
    shared_except "normal" "locked" "entersearch" "renametab" "renamepane" {
        bind "Esc" { SwitchToMode "Normal"; }
    }
    shared_among "pane" "tmux" {
        bind "x" "ч" { CloseFocus; SwitchToMode "Normal"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "Left" { PageScrollUp; }
        bind "Down" { ScrollDown; }
        bind "Up" { ScrollUp; }
        bind "Right" { PageScrollDown; }
        bind "Ctrl b" "Ctrl и" { PageScrollUp; }
        bind "Ctrl c" "Ctrl с" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "d" "в" { HalfPageScrollDown; }
        bind "Ctrl f" "Ctrl а" { PageScrollDown; }
        bind "h" "р" { PageScrollUp; }
        bind "j" "о" { ScrollDown; }
        bind "k" "л" { ScrollUp; }
        bind "l" "д" { PageScrollDown; }
        bind "Ctrl s" "Ctrl і" { SwitchToMode "Normal"; }
        bind "u" "г" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Ctrl c" "Ctrl с" { SwitchToMode "Scroll"; }
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" "Ctrl с" { SwitchToMode "Normal"; }
    }
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }
    shared_among "session" "tmux" {
        bind "d" "в" { Detach; }
    }
    tmux {
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "space" { NextSwapLayout; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; }
        bind "[" "х" { SwitchToMode "Scroll"; }
        bind "Ctrl b" "Ctrl и" { Write 2; SwitchToMode "Normal"; }
        bind "c" "с" { NewTab; SwitchToMode "Normal"; }
        bind "h" "р" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "о" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "л" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "д" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "n" "т" { GoToNextTab; SwitchToMode "Normal"; }
        bind "o" "щ" { FocusNextPane; }
        bind "p" "з" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "z" "я" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Visual & UI Configuration
simplified_ui false
pane_frames true
mouse_mode true

// Terminal & Shell Integration
default_shell "fish"
copy_command "wl-copy"
copy_clipboard "system"
copy_on_select true
scrollback_editor "zeditor"
support_kitty_keyboard_protocol true

// Session Lifecycle & Persistence
on_force_close "detach"
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

// Theme Configuration (arch-custom-os unified themes)
theme "gruvbox"

themes {
    gruvbox {
        fg "#ebdbb2"
        bg "#282828"
        black "#282828"
        red "#fb4934"
        green "#b8bb26"
        yellow "#fabd2f"
        blue "#83a598"
        magenta "#d3869b"
        cyan "#8ec07c"
        white "#ebdbb2"
        orange "#fe8019"
    }
    nord {
        fg "#eceff4"
        bg "#2e3440"
        black "#3b4252"
        red "#bf616a"
        green "#a3be8c"
        yellow "#ebcb8b"
        blue "#81a1c1"
        magenta "#b48ead"
        cyan "#88c0d0"
        white "#e5e9f0"
        orange "#d08770"
    }
}
