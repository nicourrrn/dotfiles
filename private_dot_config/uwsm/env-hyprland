# ######## Toolkit backends ########
export GDK_BACKEND='wayland,x11'
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER='wayland,x11,windows'
export CLUTTER_BACKEND='wayland'
export ELECTRON_OZONE_PLATFORM_HINT='auto'

# ####### XDG specifications #######
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# ############# Others #############
export _JAVA_AWT_WM_NONREPARENTING=1

# ############# GPU #############
# Екран і композитор — на інтегрованій AMD; VA-API (відео) теж тут, так економніше.
export LIBVA_DRIVER_NAME=radeonsi
export VDPAU_DRIVER=radeonsi
# Драйвер NVIDIA є лише в пункті Limine «Arch Linux - NVIDIA» (arch-custom-os/scripts/setup-gpu-modes.sh):
# тоді всі програми рендеряться на дискретній через PRIME render offload, без prime-run.
if [ -d /sys/module/nvidia_drm ]; then
  export __NV_PRIME_RENDER_OFFLOAD=1
  export __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
  export __GLX_VENDOR_LIBRARY_NAME=nvidia
  export __VK_LAYER_NV_optimus=NVIDIA_only
fi
